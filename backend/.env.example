# ---- TravelPia backend configuration -------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env`.

# --- App ---
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
# Comma-separated allowed origins for the mobile/web client. "*" = dev only.
CORS_ORIGINS=*

# --- LLM (text generation) ---
LLM_PROVIDER=openai                # openai | anthropic
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=               # only if LLM_PROVIDER=anthropic
# LLM_TEMPERATURE=0.45

# --- Grounding: web search (Serper) ---
SERPER_API_KEY=

# --- Images (Unsplash) ---
UNSPLASH_ACCESS_KEY=

# --- Auth (Supabase JWT) — leave off until Supabase auth is live ---
AUTH_REQUIRED=false
SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated
# Required for the /auth login/logout routes (service-role, backend only):
SUPABASE_SERVICE_ROLE_KEY=
