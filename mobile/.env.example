# Base URL of the FastAPI backend.
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time.
#
# iOS simulator / web:      http://localhost:8000
# Android emulator:         http://10.0.2.2:8000
# Physical device:          http://<your-computer-LAN-ip>:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Crash/error reporting. Leave blank locally — reporting is disabled in dev
# builds anyway. A DSN is a write-only ingest key and is safe in the bundle.
EXPO_PUBLIC_SENTRY_DSN=
