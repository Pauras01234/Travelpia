{
  "expo": {
    "name": "TravelPia",
    "slug": "travelpia",
    "version": "0.2.0",
    "scheme": "travelpia",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#14543A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.travelpia.app"
    },
    "android": {
      "package": "com.travelpia.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14543A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/68f00ac8-55cf-42f1-b00a-02221b0c989c",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "68f00ac8-55cf-42f1-b00a-02221b0c989c"
      }
    }
  }
}
